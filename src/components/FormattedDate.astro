---
import { DATE_LOCALE } from '../consts';

interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;
---

<time class={className} datetime={date.toISOString()}>
  {
    date.toLocaleDateString(DATE_LOCALE, {
      year: 'numeric',
      month: 'short',
      day: '2-digit',
      timeZone: 'UTC', // frontmatter dates are UTC midnight; sem isso o dia volta 1 no fuso BR
    })
  }
</time>
